    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "tailwindcss-animate": "^1.0.7"
  }
