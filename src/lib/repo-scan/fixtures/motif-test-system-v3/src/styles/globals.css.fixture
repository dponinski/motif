@tailwind base;
@tailwind components;
@tailwind utilities;

/*
 * Design tokens
 * Semantic colors are CSS variables holding HSL channels, so themes can swap them at runtime.
 * tailwind.config.js exposes them as utilities: bg-primary, text-muted-foreground, etc.
 */
@layer base {
  :root {
    --background: 0 0% 100%;
    --foreground: 222.2 84% 4.9%;
    --surface: 210 40% 98%;
    --muted: 210 40% 96.1%;
    --muted-foreground: 215.4 16.3% 46.9%;
    --border: 214.3 31.8% 91.4%;
    --ring: 222.2 47.4% 11.2%;

    --primary: 222.2 47.4% 11.2%;
    --primary-foreground: 210 40% 98%;
    --secondary: 210 40% 96.1%;
    --secondary-foreground: 222.2 47.4% 11.2%;

    --success: 142 71% 29%;
    --success-foreground: 210 40% 98%;
    --warning: 38 92% 50%;
    --warning-foreground: 26 83% 14%;
    --danger: 0 72% 51%;
    --danger-foreground: 210 40% 98%;
  }

  .dark {
    --background: 222.2 84% 4.9%;
    --foreground: 210 40% 98%;
    --surface: 217.2 32.6% 10%;
    --muted: 217.2 32.6% 17.5%;
    --muted-foreground: 215 20.2% 65.1%;
    --border: 217.2 32.6% 17.5%;
    --ring: 212.7 26.8% 83.9%;

    --primary: 210 40% 98%;
    --primary-foreground: 222.2 47.4% 11.2%;
    --secondary: 217.2 32.6% 17.5%;
    --secondary-foreground: 210 40% 98%;

    --success: 142 69% 58%;
    --success-foreground: 144 61% 20%;
    --warning: 43 96% 56%;
    --warning-foreground: 26 83% 14%;
    --danger: 0 91% 71%;
    --danger-foreground: 0 63% 31%;
  }
}

@layer base {
  * {
    @apply border-border;
  }
  body {
    @apply bg-background text-foreground font-sans antialiased;
  }
}
