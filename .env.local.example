# Anthropic API key for AI features
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Set to 'true' when building for Tauri desktop
TAURI_ENV=false

# Signing in with a GitHub App (optional). Without the first two, the sign-in isn't offered.
# See "Signing in with GitHub" in the README for creating the app.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Where the site is served, when it is behind a proxy: must match the app's callback URL.
APP_URL=
