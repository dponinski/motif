# Anthropic API key for AI features
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Set to 'true' when building for Tauri desktop
TAURI_ENV=false

# Signing in with a GitHub App (optional). Without the first two, the sign-in isn't offered.
# See "Signing in with GitHub" in the README for creating the app.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Where the site is served, when it is behind a proxy: must match the app's callback URL.
APP_URL=

# Accounts (optional). Without DATABASE_URL there are no accounts and everything stays in the browser.
# See "Accounts" in the README.
DATABASE_URL=
# Who may sign in: addresses and @domain entries. Empty means nobody.
ALLOWED_EMAILS=
# Email links
SMTP_URL=
MAIL_FROM="Motif <no-reply@example.com>"
# Google and Apple
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Assistant messages per person per hour
CHAT_PER_HOUR=60

# Supabase (optional). The public URL and publishable key of the project; without them nothing uses Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
