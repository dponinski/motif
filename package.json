{
  "name": "motif",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-tailwind3.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/build-tailwind3.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:setup": "npm ci --prefix e2e/cdn",
    "e2e": "node e2e/run.js",
    "e2e:db": "node e2e/run.js db",
    "tauri": "tauri",
    "desktop:dev": "concurrently \"next dev --turbopack\" \"tauri dev\"",
    "desktop:build": "next build && tauri build",
    "live:github": "vitest run src/lib/github-live.test.ts",
    "doctor": "node --no-warnings --experimental-transform-types --env-file-if-exists=.env.local scripts/doctor.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@babel/parser": "^7.29.14",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@radix-ui/react-context-menu": "^2.2.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tauri-apps/api": "^2.1.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.17",
    "lucide-react": "^0.447.0",
    "nanoid": "^5.0.8",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "path-browserify": "^1.0.1",
    "playwright": "1.63.0",
    "style-dictionary": "^5.8.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
